{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oshi-juutai",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "NOTIFY_DB",
      "database_name": "oshi-juutai-notify",
      "database_id": "93ed81ad-0f2e-46cf-a23a-b1adbfafaf20"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "GAS_NOTIFY_URL": "https://script.google.com/macros/s/AKfycbwfZhSn18r1wN8JzMulGs_4Wk_TG9zEs_4GZLqtLVsUSfQZ7lfGp6oRmIm_Jyfu8B3yiQ/exec"
  }
}
